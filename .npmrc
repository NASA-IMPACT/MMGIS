# Skip npm's automatic peer-dependency installation. Originally required
# because a mapbox-gl/maplibre peer conflict broke fresh `npm install`;
# strict resolution succeeds again as of 2026-08, so today this instead
# keeps unused auto-peer trees out of the install (~440 packages, including
# a second, never-used webpack 4 toolchain a transitive dependency declares
# as a peer). Peers the app actually uses must be listed as real
# dependencies (e.g. leaflet, focus-trap-react). `npm ci` reads the
# lockfile directly and is unaffected either way.
legacy-peer-deps=true
