                        "width": 12
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.themes",
                        "name": "Themes (JSON)",
                        "description": "The rail's entries: [{ id, label, icon }]. `icon` is an MDI name without the 'mdi-' prefix. Each `id` must match a theme id in the paired filter panel's config — that id is what the rail broadcasts on selection.",
