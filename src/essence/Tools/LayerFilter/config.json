{
    "name": "LayerFilter",
    "defaultIcon": "filter-outline",
    "description": "Two-step, configurable layer filter. Step 1 picks a theme; step 2 shows that theme's filters. Emits the matched layer set on the event bus (does not change layers itself).",
    "hasVars": true,
    "width": 320,
    "height": 0,
    "paths": {
        "LayerFilterTool": "essence/Tools/LayerFilter/LayerFilterTool"
    },
    "metadata": {
        "icon": "filter-outline",
        "requiredOrientation": "vertical",
        "compatiblePositions": [
            "left",
            "right"
        ],
        "preferredPosition": "left",
        "modernLayoutSupport": true,
        "width": 320,
        "height": 0
    },
    "variables": {
        "defaultThemeId": "need",
        "themes": [
            {
                "id": "need",
                "label": "Need",
                "icon": "satellite-variant",
                "title": "Need",
                "description": "Filter by sector to explore Earth-science datasets relevant to your operational needs.",
                "filters": [
                    {
                        "id": "sector",
                        "label": "Sector",
                        "property": "sector",
                        "multi": true,
                        "allLabel": "All Sectors"
                    }
                ]
            },
            {
                "id": "hazard",
                "label": "Hazard",
                "icon": "flash-outline",
                "title": "Hazard",
                "description": "Explore datasets by hazard type to understand conditions, impacts, and response context.",
                "filters": [
                    {
                        "id": "hazard",
                        "label": "Hazard",
                        "property": "hazard",
                        "allLabel": "All Hazards"
                    }
                ]
            },
            {
                "id": "event",
                "label": "Event",
                "icon": "calendar-outline",
                "title": "Event",
                "description": "Filter the activation catalogue by hazard, location and year.",
                "catalog": "activations",
                "filters": [
                    {
                        "id": "hazardType",
                        "label": "Hazard Type",
                        "property": "hazards",
                        "from": "catalog",
                        "allLabel": "All Hazards"
                    },
                    {
                        "id": "year",
                        "label": "Year",
                        "from": "catalog",
                        "derived": "datetimes",
                        "allLabel": "All Years"
                    },
                    {
                        "id": "activation",
                        "label": "Activation",
                        "from": "catalog",
                        "isEntry": true,
                        "allLabel": "Select an activation"
                    }
                ]
            }
        ],
        "catalog": {
            "type": "FeatureCollection",
            "features": []
        }
    },
    "config": {
        "rows": [
            {
                "components": [
                    {
                        "field": "variables.themeProperty",
                        "name": "Theme property",
                        "description": "The layer.properties key that holds a layer's theme id.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.defaultThemeId",
                        "name": "Default theme",
                        "description": "Theme id selected on load.",
                        "type": "text",
                        "width": 3
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.themes",
                        "name": "Themes & filters (JSON)",
                        "description": "The two-step filter config. Each theme: { id, label, icon, title, description, filters: [ { id, label, property, type: \"select\", allLabel, options: [ { value, label } ] } ] }. `property` is the layer.properties key the filter matches against; `icon` is an MDI name (e.g. \"flash-outline\").",
                        "type": "json",
                        "width": 12,
                        "height": "440px"
                    }
                ]
            }
        ]
    }
}
