    "name": "LayerFilter",
    "defaultIcon": "filter-outline",
    "description": "Two-step, configurable layer filter panel. Step 1 (a separate LayerFilterThemes rail) picks a theme; step 2 shows that theme's filters. Emits the matched layer set on the event bus. Events \u2014 provides: plugin:layerfilter:getThemes; emits: plugin:layerfilter:ready, plugin:layerfilter:changed { themeId, selections, matchedLayerUUIDs }; subscribes: plugin:layerfilterthemes:selectedThemeChanged.",
    "hasVars": true,
    "width": 320,
    "height": 0,
    "paths": {
        "LayerFilterTool": "essence/Tools/LayerFilter/LayerFilterTool"
    },
    "metadata": {
        "icon": "filter-outline",
        "requiredOrientation": "vertical",
        "compatiblePositions": [
            "left",
            "right"
        ],
        "preferredPosition": "left",
        "modernLayoutSupport": true,
        "width": 320,
        "height": 0
    },
    "config": {
        "rows": [
            {
                "components": [
                    {
                        "field": "variables.themeProperty",
                        "name": "Theme property",
                        "description": "The layer.properties key that holds a layer's theme id.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.defaultThemeId",
                        "name": "Default theme",
                        "description": "Theme id selected on load.",
                        "type": "text",
                        "width": 3
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.themes",
                        "name": "Themes & filters (JSON)",
                        "description": "The two-step filter config. Each theme: { id, label, icon, title, description, filters: [ { id, label, property, type: \"select\", allLabel, options: [ { value, label } ] } ] }. `property` is the layer.properties key the filter matches against; `icon` is an MDI name (e.g. \"flash-outline\").",
                        "type": "json",
                        "width": 12,
                        "height": "440px"
                    }
                ]
            }
        ]
    }
}
