{
    "defaults": {
        "variables": {
            "defaultThemeId": "need",
            "themes": [
                {
                    "id": "need",
                    "label": "Need",
                    "icon": "satellite-variant",
                    "title": "Need",
                    "description": "Filter by sector to explore Earth-science datasets relevant to your operational needs.",
                    "filters": [
                        {
                            "id": "sector",
                            "label": "Sector",
                            "property": "sector",
                            "multi": true,
                            "allLabel": "All Sectors"
                        }
                    ]
                },
                {
                    "id": "hazard",
                    "label": "Hazard",
                    "icon": "flash-outline",
                    "title": "Hazard",
                    "description": "Explore datasets by hazard type to understand conditions, impacts, and response context.",
                    "filters": [
                        {
                            "id": "hazard",
                            "label": "Hazard",
                            "property": "hazard",
                            "allLabel": "All Hazards"
                        }
                    ]
                },
                {
                    "id": "event",
                    "label": "Event",
                    "icon": "calendar-outline",
                    "title": "Event",
                    "description": "Filter the activation catalogue by hazard, location and year.",
                    "catalog": "activations",
                    "filters": [
                        {
                            "id": "hazardType",
                            "label": "Hazard Type",
                            "property": "hazards",
                            "from": "catalog",
                            "allLabel": "All Hazards"
                        },
                        {
                            "id": "location",
                            "label": "Location",
                            "from": "catalog",
                            "type": "geocode",
                            "allLabel": "Search places\u2026"
                        },
                        {
                            "id": "year",
                            "label": "Year",
                            "from": "catalog",
                            "derived": "datetimes",
                            "allLabel": "All Years"
                        },
                        {
                            "id": "activation",
                            "label": "Activation",
                            "from": "catalog",
                            "isEntry": true,
                            "allLabel": "Select an activation",
                            "countLabel": "activations"
                        }
                    ]
                }
            ],
            "catalog": {
                "type": "FeatureCollection",
                "features": []
            },
            "geocoder": {
                "url": ""
            }
        }
    },
    "name": "LayerFilter",
    "defaultIcon": "filter-outline",
    "description": "Two-step, configurable layer filter panel. Step 1 (a separate LayerFilterThemes rail) picks a theme; step 2 shows that theme's filters. Emits the matched layer set on the event bus. Events \u2014 provides: plugin:layerfilter:getThemes; emits: plugin:layerfilter:ready, plugin:layerfilter:changed { themeId, selections, matchedLayerUUIDs }; subscribes: plugin:layerfilterthemes:selectedThemeChanged.",
    "hasVars": true,
    "width": 320,
    "height": 0,
    "paths": {
        "LayerFilterTool": "essence/Tools/LayerFilter/LayerFilterTool"
    },
    "metadata": {
        "icon": "filter-outline",
        "requiredOrientation": "vertical",
        "compatiblePositions": [
            "left",
            "right"
        ],
        "preferredPosition": "left",
        "modernLayoutSupport": true,
        "width": 320,
        "height": 0
    },
    "config": {
        "rows": [
            {
                "components": [
                    {
                        "field": "variables.defaultThemeId",
                        "name": "Default theme",
                        "description": "Theme id selected on load.",
                        "type": "text",
                        "width": 3
                    },
                    {
                        "field": "variables.geocoder.url",
                        "name": "Geocoder URL",
                        "description": "Nominatim-style search endpoint for 'geocode' Location filters. Leave empty to hide those controls.",
                        "type": "text",
                        "width": 9
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.themes",
                        "name": "Themes & filters (JSON)",
                        "description": "The two-step filter config. Each theme: { id, label, icon, title, description, catalog?, filters: [...] }. Filters default to matching layer.properties[property]; `multi: true` allows several values (`matchAll: true` = contains-all); `from: \"catalog\"` reads catalogue entry properties, with `derived: \"datetimes\"` for a Year filter, `isEntry: true` for a pick-one-entry control, and `type: \"geocode\"` for a place search that keeps entries by geometry intersection (layer themes test the layer's own properties.bbox [west, south, east, north] first). Options and counts are always derived from the data, never enumerated here.",
                        "type": "json",
                        "width": 12,
                        "height": "440px"
                    }
                ]
            },
            {
                "components": [
                    {
                        "field": "variables.catalog",
                        "name": "Catalogue (GeoJSON)",
                        "description": "FeatureCollection of catalogue entries (e.g. activations): id, tag properties, datetimes, geometry, and the layer keys each entry pairs with. See SCHEMA.md.",
                        "type": "json",
                        "width": 12,
                        "height": "300px"
                    }
                ]
            }
        ]
    }
}
