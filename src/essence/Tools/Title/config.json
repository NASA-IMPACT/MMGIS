{
    "name": "Title",
    "description": "Display mission icon and title from the mission config file.",
    "descriptionFull": {
        "title": "Title Tool",
        "example": {
            "sortAlphabetically": true
        }
    },
    "defaultIcon": "information-variant",
    "hasVars": true,
    "toolbarPriority": 3,
    "width": 300,
    "height": 0,
    "paths": {
        "TitleTool": "essence/Tools/Title/TitleTool"
    },
    "tests": {},
    "expandable": false,
    "separatedTool": false,
    "metadata": {
        "icon": "information-variant",
        "requiredOrientation": "horizontal",
        "compatiblePositions": ["top"],
        "preferredPosition": "top",
        "modernLayoutSupport": true,
        "width": 300,
        "height": 0
    },
    "config": {
        "rows": [
            {
                "components": [
                    {
                        "field": "variables.showLogo",
                        "name": "Show Logo",
                        "description": "Dictates whether or not the logo/icon is visible in the rendered tool.",
                        "type": "checkbox",
                        "width": 6,
                        "defaultChecked": true
                    },
                    {
                        "field": "variables.showTitleText",
                        "name": "Show Title Text",
                        "description": "Dictates whether or not the title text is visible in the rendered tool.",
                        "type": "checkbox",
                        "width": 6,
                        "defaultChecked": true
                    }
                ]
            },
            {
                "name": "Action Button",
                "description": "Configure an optional action button displayed on the side of the title.",
                "components": [
                    {
                        "field": "variables.actionButtonText",
                        "name": "Button Text",
                        "description": "Text to display on the action button. Leave empty to hide the button.",
                        "type": "text",
                        "width": 6
                    },
                    {
                        "field": "variables.actionButtonLink",
                        "name": "Button Link",
                        "description": "Can be an external URL (e.g., 'https://example.com') or an MMGIS event name (e.g., 'analyzeArea').",
                        "type": "text",
                        "width": 6
                    }
                ]
            }
        ]
    }
}
